# Filled in automatically by `bun run discover` and `bun run pair`
HUE_BRIDGE_IP=
HUE_USERNAME=
HUE_LIGHT_ID=

# Local notifier server
PORT=7878

# Idle timeout: after `done` event, fade back to idle color (ms)
IDLE_AFTER_DONE_MS=8000

# Debounce window for working events to avoid flicker (ms)
DEBOUNCE_MS=150
